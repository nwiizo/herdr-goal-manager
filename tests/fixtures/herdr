#!/bin/sh
set -eu
case "$1 $2" in
  "pane list") cat "$FIXTURE_ROOT/panes.json" ;;
  "pane process-info") cat "$FIXTURE_ROOT/process.json" ;;
  "agent list") cat "$FIXTURE_ROOT/agents.json" ;;
  "agent read")
    if [ "$3" = w1:p1 ]; then
      if [ -f "$FIXTURE_ROOT/dialog-when-sending" ] && grep -q '"outcome": "sending"' "$(cat "$FIXTURE_ROOT/dialog-when-sending")"; then
        cat "$FIXTURE_ROOT/dialog.screen"
        exit 0
      fi
      if [ "$5" = recent-unwrapped ] && [ -f "$FIXTURE_ROOT/target.recent" ]; then cat "$FIXTURE_ROOT/target.recent"; else cat "$FIXTURE_ROOT/target.screen"; fi
      if [ -f "$FIXTURE_ROOT/after-read.screen" ]; then mv "$FIXTURE_ROOT/after-read.screen" "$FIXTURE_ROOT/target.screen"; fi
    else cat "$FIXTURE_ROOT/manager.screen"; fi ;;
  "agent prompt")
    printf '%s\n%s\n' "$3" "$4" >> "$FIXTURE_ROOT/sent.txt"
    if [ "$3" = w1:p1 ] && [ -f "$FIXTURE_ROOT/snapshot-prepared" ]; then
      cp "$(cat "$FIXTURE_ROOT/snapshot-prepared")" "$FIXTURE_ROOT/prepared-at-prompt.json" 2>/dev/null || true
    fi
    if [ -f "$FIXTURE_ROOT/fail-send" ]; then exit 1; fi
    if [ -f "$FIXTURE_ROOT/fail-send-$3" ]; then exit 1; fi
    if [ -f "$FIXTURE_ROOT/after-prompt.screen" ]; then cp "$FIXTURE_ROOT/after-prompt.screen" "$FIXTURE_ROOT/target.screen"; fi
    if [ "$3" != w1:p1 ] && [ -f "$FIXTURE_ROOT/after-prompt-manager.screen" ]; then cp "$FIXTURE_ROOT/after-prompt-manager.screen" "$FIXTURE_ROOT/manager.screen"; fi
    if [ "$3" = w1:p1 ] && [ ! -f "$FIXTURE_ROOT/goal-pasted" ]; then
      case "$4" in
        "/goal clear") answer="  ⎿  Goal cleared: (fixture)" ;;
        "/goal "*) answer="  ⎿  Goal set: ${4#/goal }" ;;
        *) answer="" ;;
      esac
      if [ -n "$answer" ]; then
        { printf '%s\n' "$answer"; cat "$FIXTURE_ROOT/target.screen"; } > "$FIXTURE_ROOT/target.answer"
        mv "$FIXTURE_ROOT/target.answer" "$FIXTURE_ROOT/target.screen"
      fi
    fi
    if [ "$3" = w1:p2 ]; then
      case "$4" in
        "/goal clear") answer="  ⎿  Goal cleared: (fixture)" ;;
        "/goal "*) answer="  ⎿  Goal set: ${4#/goal }" ;;
        *) answer="" ;;
      esac
      if [ -n "$answer" ]; then
        { printf '%s\n' "$answer"; cat "$FIXTURE_ROOT/manager.screen"; } > "$FIXTURE_ROOT/manager.answer"
        mv "$FIXTURE_ROOT/manager.answer" "$FIXTURE_ROOT/manager.screen"
      fi
    fi
    if [ "$4" = /exit ] && [ -f "$FIXTURE_ROOT/exited.json" ]; then
      cp "$FIXTURE_ROOT/exited.json" "$FIXTURE_ROOT/panes.json"
      cp "$FIXTURE_ROOT/exited-agents.json" "$FIXTURE_ROOT/agents.json"
    fi
    printf '{"result":{"type":"admitted"}}\n' ;;
  "agent start")
    for arg in "$@"; do
      case "$arg" in *"
"*) printf '{"error":{"code":"invalid_agent_argument"}}\n' >&2; exit 1 ;; esac
    done
    printf '%s\n' "$@" >> "$FIXTURE_ROOT/started.txt"
    if [ -f "$FIXTURE_ROOT/fail-start" ]; then printf '{"error":{"code":"agent_blocked"}}\n' >&2; exit 1; fi
    if [ -f "$FIXTURE_ROOT/successor.json" ]; then
      cp "$FIXTURE_ROOT/successor.json" "$FIXTURE_ROOT/panes.json"
      cp "$FIXTURE_ROOT/successor-agents.json" "$FIXTURE_ROOT/agents.json"
    fi
    if [ -f "$FIXTURE_ROOT/role-panes.json" ]; then
      cp "$FIXTURE_ROOT/role-panes.json" "$FIXTURE_ROOT/panes.json"
      cp "$FIXTURE_ROOT/role-panes.json" "$FIXTURE_ROOT/agents.json"
    fi
    printf '{"result":{}}\n' ;;
  "pane report-metadata") printf '%s\n' "$@" >> "$FIXTURE_ROOT/metadata.txt"; printf '{"result":{}}\n' ;;
  "notification show") printf '%s\n' "$3" >> "$FIXTURE_ROOT/notified.txt"; printf '{"result":{}}\n' ;;
  "plugin pane") printf '%s\n' "$@" >> "$FIXTURE_ROOT/opened.txt"; printf '{"result":{}}\n' ;;
  "tab get") cat "$FIXTURE_ROOT/tab.json" ;;
  "tab rename") printf '%s %s\n' "$3" "$4" >> "$FIXTURE_ROOT/renamed.txt"; printf '{"result":{}}\n' ;;
  "tab focus") printf '%s\n' "$3" >> "$FIXTURE_ROOT/focused.txt"; printf '{"result":{}}\n' ;;
  "tab create") printf '%s\n' "$@" >> "$FIXTURE_ROOT/created.txt"; cat "$FIXTURE_ROOT/tab-create.json" ;;
  "tab close") printf '%s\n' "$3" >> "$FIXTURE_ROOT/closed.txt"; printf '{"result":{"type":"ok"}}\n' ;;
  "worktree create"|"worktree open"|"worktree remove")
    printf '%s\n' "$*" >> "$FIXTURE_ROOT/worktree.txt"
    while [ -e "$FIXTURE_ROOT/hold-worktree" ]; do sleep 0.05; done
    action=$2; shift 2
    cwd=; branch=; base=; path=; workspace=; kind=
    while [ $# -gt 0 ]; do
      case "$1" in
        --cwd) cwd=$2; shift ;;
        --branch) branch=$2; shift ;;
        --base) base=$2; shift ;;
        --path) path=$2; shift ;;
        --workspace) workspace=$2; shift ;;
        --label) shift ;;
      esac
      shift
    done
    case "$action" in
      create)
        path=${path:-"$cwd-$branch"}
        git -C "$cwd" worktree add -q -b "$branch" "$path" "$base" >&2
        workspace=w9; kind=worktree_created ;;
      open)
        branch=$(git -C "$path" rev-parse --abbrev-ref HEAD)
        workspace=w8; kind=worktree_opened ;;
      remove)
        path=$(cat "$FIXTURE_ROOT/worktree-$workspace")
        common=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)
        git -C "$common/.." worktree remove "$path" >&2
        printf '{"result":{"type":"worktree_removed"}}\n'
        exit 0 ;;
    esac
    printf '%s' "$path" > "$FIXTURE_ROOT/worktree-$workspace"
    printf '{"result":{"type":"%s","workspace":{"workspace_id":"%s","worktree":{"checkout_path":"%s"}},"worktree":{"branch":"%s","path":"%s"}}}\n' "$kind" "$workspace" "$path" "$branch" "$path" ;;
  *) printf 'unexpected fixture command\n' >&2; exit 2 ;;
esac
